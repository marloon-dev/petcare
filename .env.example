# Copie este arquivo para .env e ajuste os valores.

# Chave usada pelo Flask para assinar a sessão (troque por um texto aleatório).
SECRET_KEY=troque-por-uma-chave-aleatoria

# Conexão com o MySQL (usuário, senha, host, porta e banco).
DATABASE_URL=mysql+pymysql://root:SUA_SENHA@127.0.0.1:3306/petcare?charset=utf8mb4

# Alternativa sem MySQL: banco SQLite de demonstração (crie com: flask --app run criar-demo)
# DATABASE_URL=sqlite:///demo.db
